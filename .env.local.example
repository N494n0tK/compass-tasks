# Firebase コンソール > プロジェクトの設定 > マイアプリ(ウェブ) から取得
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Notion 連携（docs/notebook/notion-pull.md）。サーバー側のみで使う(NEXT_PUBLIC を付けない)
# NOTION_TOKEN: https://www.notion.so/my-integrations で作ったインテグレーションのシークレット
# NOTION_NOTES_PAGE_ID: 「Compass取り込みJSON」ページ URL 末尾の 32 桁 id
NOTION_TOKEN=
NOTION_NOTES_PAGE_ID=
# 公開 URL（Vercel）では必須: 受け取りを許可する Google アカウントのメール(カンマ区切り)。
# 設定すると /api/notion/pull が Firebase ログインの ID トークンを要求する。ローカルでは空でよい
NOTION_ALLOWED_EMAILS=
